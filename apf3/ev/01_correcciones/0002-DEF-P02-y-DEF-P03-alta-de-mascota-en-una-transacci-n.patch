Subject: [PATCH 2/5] =?UTF-8?q?DEF-P02=20y=20DEF-P03:=20alta=20de=20mascot?=
 =?UTF-8?q?a=20en=20una=20transacci=C3=B3n=20con=20el=20propietario=20bloq?=
 =?UTF-8?q?ueado?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

El alta relee al propietario con SELECT ... FOR UPDATE dentro de una transacción, de modo que dos solicitudes simultáneas ya no guardan copias desactualizadas que desvinculan mascotas (owner_id nulo). El duplicado de MySQL (restricción sin nombre, 'pets.owner_id') se reconoce y se responde con error de validación en lugar de HTTP 500. Se ajusta el doble de prueba de PetControllerTests y se añaden pruebas de las correcciones, incluida E01ConcurrenciaTests.
---
 .../petclinic/owner/OwnerRepository.java      |  40 ++++++
 .../petclinic/owner/PetController.java        |  19 ++-
 .../petclinic/E01ConcurrenciaTests.java       | 130 ++++++++++++++++++
 .../petclinic/owner/PetControllerTests.java   |  41 +++++-
 4 files changed, 223 insertions(+), 7 deletions(-)
 create mode 100644 src/test/java/org/springframework/samples/petclinic/E01ConcurrenciaTests.java

diff --git a/src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java b/src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java
index d2b3dde..e4168e2 100644
--- a/src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java
+++ b/src/main/java/org/springframework/samples/petclinic/owner/OwnerRepository.java
@@ -20,6 +20,12 @@ import java.util.Optional;
 import org.springframework.data.domain.Page;
 import org.springframework.data.domain.Pageable;
 import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Lock;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+import org.springframework.transaction.annotation.Transactional;
+
+import jakarta.persistence.LockModeType;
 
 /**
  * Repository class for <code>Owner</code> domain objects. All method names are compliant
@@ -59,4 +65,38 @@ public interface OwnerRepository extends JpaRepository<Owner, Integer> {
 	 */
 	Optional<Owner> findById(Integer id);
 
+	/**
+	 * Retrieve an {@link Owner} locking its row until the current transaction ends
+	 * (SELECT ... FOR UPDATE), so that concurrent requests for the same owner are
+	 * serialized.
+	 * @param id the id to search for
+	 * @return the locked owner, if found
+	 */
+	@Lock(LockModeType.PESSIMISTIC_WRITE)
+	@Query("SELECT owner FROM Owner owner WHERE owner.id = :id")
+	Optional<Owner> findByIdForUpdate(@Param("id") Integer id);
+
+	/**
+	 * Add a new pet to the owner inside one transaction, re-reading the owner with a
+	 * pessimistic lock. Two simultaneous requests can no longer save stale copies of the
+	 * owner that unlink each other's pets (DEF-P02), and the second request sees the pet
+	 * saved by the first one, so a duplicate name is rejected instead of failing in the
+	 * database (DEF-P03).
+	 * @param ownerId the owner id
+	 * @param pet the new pet
+	 * @return {@code true} if the pet was added, {@code false} if the owner already has a
+	 * pet with the same name
+	 */
+	@Transactional
+	default boolean addPetIfNameAvailable(Integer ownerId, Pet pet) {
+		Owner owner = findByIdForUpdate(ownerId)
+			.orElseThrow(() -> new IllegalStateException("Owner not found with id: " + ownerId));
+		if (owner.getPet(pet.getName(), true) != null) {
+			return false;
+		}
+		owner.addPet(pet);
+		saveAndFlush(owner);
+		return true;
+	}
+
 }
